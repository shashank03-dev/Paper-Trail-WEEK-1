# Ollama + Gemma 4 for Render (private service). The model is pulled on first boot.
FROM ollama/ollama:latest
COPY deploy/ollama-start.sh /usr/local/bin/ollama-start.sh
ENV OLLAMA_HOST=0.0.0.0:11434 OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_KEEP_ALIVE=24h
EXPOSE 11434
ENTRYPOINT ["/bin/sh", "/usr/local/bin/ollama-start.sh"]
