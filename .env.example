# The OpenAI-compatible endpoint of an OPEN model. Default: local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_TEXT=gemma4:e4b
LLM_MODEL_VISION=gemma4:e4b
LLM_TIMEOUT_MS=120000
# true = use Ollama's native /api/chat with `format: <schema>` instead of /v1 response_format
LLM_OLLAMA_NATIVE=false

NOMINATIM_EMAIL=you@example.com        # required by Nominatim usage policy
OVERPASS_URL=https://overpass-api.de/api/interpreter
DEVICE_LABEL="my laptop"                # printed in the colophon
DEMO_MODE=false                         # true = use cached fixtures, no network

# Public base URL used in the QR code on page 8 (use your LAN IP so a phone can open it).
PUBLIC_URL=http://localhost:3000
# Let the Settings page override the endpoint per browser. Keep false on public deploys.
ALLOW_ENDPOINT_OVERRIDE=false
REPO_URL=https://github.com/shashank03-dev/Paper-Trail-WEEK-1
