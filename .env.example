# ── Where Gemma runs ──────────────────────────────────────────────────────────
# ollama        local Ollama (default, nothing leaves your machine)
# ollama-cloud  Ollama's hosted API          → set OLLAMA_API_KEY
# gemini        Google's Gemini API (Gemma)  → set GEMINI_API_KEY
# openai-compat any OpenAI-compatible endpoint → set LLM_BASE_URL (+ LLM_API_KEY)
# A comma list is a fallback chain, e.g. "gemini,ollama-cloud".
# Leave empty to auto-pick: Gemini if GEMINI_API_KEY is set, then Ollama Cloud, else local Ollama.
LLM_PROVIDER=

GEMINI_API_KEY=                         # https://aistudio.google.com/apikey
GEMINI_MODEL_TEXT=gemma-4-26b-a4b-it    # or gemma-4-31b-it
GEMINI_MODEL_VISION=gemma-4-26b-a4b-it

OLLAMA_API_KEY=                         # https://ollama.com/settings/keys
OLLAMA_CLOUD_MODEL_TEXT=gemma4:31b
OLLAMA_CLOUD_MODEL_VISION=gemma4:31b

# Local Ollama / custom OpenAI-compatible endpoint (hosted providers ignore these)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_TEXT=gemma4:e4b
LLM_MODEL_VISION=gemma4:e4b
LLM_TIMEOUT_MS=120000
# true = use Ollama's native /api/chat with `format: <schema>` instead of /v1
LLM_OLLAMA_NATIVE=false

# ── Places, weather, app ──────────────────────────────────────────────────────
NOMINATIM_EMAIL=you@example.com        # required by Nominatim usage policy
OVERPASS_URL=https://overpass-api.de/api/interpreter
DEVICE_LABEL="my laptop"                # printed in the colophon (local mode)
DEMO_MODE=false                         # true = use cached fixtures, no network
# Public base URL used in the QR code on page 8.
PUBLIC_URL=http://localhost:3000
# Let the Settings page override the endpoint per browser. Keep false on public deploys.
ALLOW_ENDPOINT_OVERRIDE=false
REPO_URL=https://github.com/shashank03-dev/Paper-Trail-WEEK-1
